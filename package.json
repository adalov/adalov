{
  "name": "adalov",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js framework based on TypeScript for building microservices-oriented applications",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.packages.build.json",
    "build:dev": "tsc --build tsconfig.packages.json",
    "clear": "bash ./scripts/clear.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare:packages": "bash ./scripts/prepare-packages.sh",
    "playground": "bash ./scripts/playground.sh",
    "playground:build": "tsc --project playground/tsconfig.json",
    "playground:watch": "tsc --project playground/tsconfig.json --watch",
    "playground:start": "node --watch playground/.build/index.js",
    "test": "bash ./scripts/test.sh",
    "test:watch": "bash ./scripts/test-watch.sh",
    "test:coverage": "bash ./scripts/test-coverage.sh",
    "tsc": "tsc",
    "commitlint": "commitlint",
    "validate:branch": "bash scripts/validate-branch-name.sh",
    "validate:pr-name": "bash scripts/validate-pr-name.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adalov/adalov.git"
  },
  "keywords": [
    "nodejs",
    "node",
    "api",
    "typescript",
    "rest",
    "restful",
    "microservices",
    "nodejs-framework",
    "typescript-framework"
  ],
  "author": "Franco Basaglia <francobasaglia94@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adalov/adalov/issues"
  },
  "homepage": "https://github.com/adalov/adalov#readme",
  "engines": {
    "node": ">=22.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "~22.15.4",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
