{
  "name": "adalov",
  "private": true,
  "description": "Node.js framework based on TypeScript for building microservices-oriented applications",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.packages.build.json",
    "build:dev": "tsc --build tsconfig.packages.json",
    "clear": "sh ./scripts/clear.sh",
    "prepare:packages": "sh ./scripts/prepare-packages.sh",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adalov/adalov.git"
  },
  "keywords": [
    "nodejs",
    "node",
    "api",
    "typescript",
    "rest",
    "restful",
    "microservices",
    "nodejs-framework",
    "typescript-framework"
  ],
  "author": "Franco Basaglia <francobasaglia94@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adalov/adalov/issues"
  },
  "homepage": "https://github.com/adalov/adalov#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}